{:paths ["src"]
 :deps {
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.langgraph"}
        ;; kotoba-lang/activity is this vertical's domain capability
        ;; library (observations, segmentation, attribution, admission,
        ;; timesheet emission). Referenced by workspace-sibling path per
        ;; the fleet's capability-library-wrapping convention (same as
        ;; cloud-itonami-isco-4313 wraps kotoba-lang/labor). Unlike labor
        ;; it is dependency-free, so it is also consumable as a plain git
        ;; dep once a fork wants one.
        io.github.kotoba-lang/activity
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.activity"}
        ;; shared langchain.db store seam (EDN-blob codec + identity
        ;; schema + seq-keyed event streams), so the DatomicStore does not
        ;; hand-roll the two-line codec ~190 stores already duplicate
        ;; (ADR-2607141600).
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.langchainStore"}
        ;; CACAO verification for the edge. Depended on, never
        ;; reimplemented: did:key, the SIWE plaintext, the CBOR envelope,
        ;; Ed25519 and the temporal window all live here and must live
        ;; nowhere else (ADR-2607268000 — hand-synced copies of this in
        ;; ~25 repos measurably diverged).
        io.github.kotoba-lang/org-chainagnostic-cacao
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/org.chainagnostic.cacao"}}
 :aliases
 {;; clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}
  ;; The :cljs branch of the edge ns. shadow-cljs.edn declares
  ;; :deps {:aliases [:cljs]}, so shadow itself has to be on THIS
  ;; classpath — `npm install` alone puts the launcher in node_modules
  ;; and the build then fails to locate shadow.cljs.devtools.cli.
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      thheller/shadow-cljs {:mvn/version "2.28.20"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
